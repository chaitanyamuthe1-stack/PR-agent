# PR Agent Environment Configuration

# Primary Cloud Gateway (Gemini 3.8 Flash / 2.5 Flash / 1.5 Flash)
GEMINI_API_KEY=

# Secondary Cloud Gateway (Groq)
GROQ_API_KEY=

# Local Ollama Gateway (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Default Provider: gemini | groq | ollama | offline
DEFAULT_PROVIDER=gemini

# Application Settings
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Supabase Persistence Configuration (Optional)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

